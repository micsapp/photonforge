# ==============================================================================
# PhotonForge - Environment Configuration
# ==============================================================================

# --- Port & Site Settings ---
PHOTONFORGE_PORT=2342
PHOTONFORGE_SITE_URL=http://localhost:2342/

# --- Authentication ---
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=forge_super_secret_password_change_me!

# --- Database (MariaDB) ---
DB_ROOT_PASSWORD=forge_root_password_change_me!
DB_USER=photonforge
DB_PASSWORD=forge_db_password_change_me!
DB_NAME=photonforge

# --- RAW & GPU Performance Tuning ---
# Number of background indexing workers (set to match CPU cores or GPU capacity)
PHOTOPRISM_WORKERS=4

# Enable Darktable for OpenCL GPU accelerated RAW demosaicing
PHOTOPRISM_DARKTABLE_PRESETS=true
PHOTOPRISM_DISABLE_RAW=false

# GPU Driver Options: 'nvidia', 'intel', or 'none'
# When using NVIDIA, make sure nvidia-container-toolkit is installed.
GPU_DRIVER=nvidia

# --- Storage Paths (Host paths) ---
# For Windows/WSL2, you can map your Windows drive (e.g., /mnt/d/Photos/RAW)
PATH_ORIGINALS=./data/originals
PATH_STORAGE=./data/storage
PATH_IMPORT=./data/import
